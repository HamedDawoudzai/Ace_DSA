# Copy to .env and set values. Do not commit .env.
# For Docker: use docker compose; it sets DB_URL and JWT_SECRET for you.

# Database URL (e.g. postgres://user:pass@localhost:5432/acedsa?sslmode=disable)
# With docker compose: postgres://acedsa:acedsa@localhost:5432/acedsa?sslmode=disable
DB_URL=

# JWT signing secret (min 32 chars recommended)
JWT_SECRET=

# HTTP port (default 8080)
PORT=8080
