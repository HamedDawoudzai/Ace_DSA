# Copy to .env in this folder. Never commit .env.

# =============================================================================
# REQUIRED
# =============================================================================

# --- Database ---
#
# Supabase (recommended for hosted DB):
#   Dashboard -> Project Settings -> Database -> Connection string -> tab "URI"
#   Choose "Direct connection" (this API runs migrations on startup; avoid
#   "Transaction" pooler for that, or run migrations separately with --migrate-only).
#   Paste the URI and replace [YOUR-PASSWORD] with the database password.
#   The string should include SSL, e.g. ...?sslmode=require
#
# Example shape (do not use literally):
# DB_URL=postgresql://postgres.xxxxx:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
#
# Local Postgres (or use docker-compose):
# DB_URL=postgres://acedsa:acedsa@localhost:5432/acedsa?sslmode=disable

DB_URL=

# --- JWT ---
# Signing secret for access & refresh tokens.
# MUST be at least 32 characters. Generate with:
#   openssl rand -base64 64

JWT_SECRET=

# =============================================================================
# OPTIONAL
# =============================================================================

# HTTP port (default 8080)
PORT=8080

# --- CORS ---
# Comma-separated list of allowed origins. Leave empty or "*" for wide-open
# (development only!). In production set to your app domain(s):
# CORS_ORIGINS=https://acedsa.app,https://www.acedsa.app
CORS_ORIGINS=

# --- Logging ---
# Set to "json" for structured JSON logs (recommended in production).
# Omit or set to anything else for plain text.
LOG_FORMAT=

# --- SMTP (email) ---
# Used for password-reset and email-verification emails.
# When not set the server logs emails instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- App URL ---
# Base URL of the mobile/web app. Used in emails for reset/verify links.
# APP_URL=https://acedsa.app
APP_URL=

# --- Sentry ---
# Optional DSN for backend error tracking.
# SENTRY_DSN=
